      "required_files": ["m5-forecasting-accuracy.zip"],
      "archive_members": ["calendar.csv", "sales_train_validation.csv"],
      "license": "upstream competition terms; no redistribution"
    },
    "bpi2019": {
      "source": "https://data.4tu.nl/articles/dataset/BPI_Challenge_2019/12715853/1",
      "required_files": ["BPIChallenge2019CSV.zip"],
      "archive_members": ["BPI_Challenge_2019.csv"],
      "license": "CC BY 4.0"
    },
    "lade": {
      "source": "https://huggingface.co/datasets/Cainiao-AI/LaDe",
      "required_files": ["delivery_jl.csv"],
